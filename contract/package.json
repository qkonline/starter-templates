{
  "name": "@starter/contract",
  "private": true,
  "version": "0.1.0",
  "description": "The API every starter backend implements and every starter frontend calls, with the tests that hold a backend to it.",
  "license": "MIT",
  "author": "Qaisar Khan <kaiser@kaiserkhan.com>",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "exports": {
    "./types": "./types.ts",
    "./password": "./password.ts",
    "./openapi.yaml": "./openapi.yaml"
  },
  "scripts": {
    "lint": "redocly lint openapi.yaml",
    "types": "openapi-typescript openapi.yaml -o types.ts",
    "check": "npm run lint && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@redocly/cli": "^2.72.0",
    "@types/node": "^24.19.2",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12",
    "yaml": "^2.9.1"
  }
}
