# Every variable is read at build time and written into the files, so set them before
# `npm run build` (or `npm run deploy`). See README → Environment variables.

# Where the backend answers: the server URL from contract/openapi.yaml, ending in /api.
PUBLIC_API_URL=http://localhost:8787/api

# PostHog: set the project key to switch it on; nothing loads without it.
PUBLIC_POSTHOG_KEY=
# Default https://us.i.posthog.com; https://eu.i.posthog.com for the EU cloud.
PUBLIC_POSTHOG_HOST=

# Google Analytics 4 measurement id (G-…): set it to switch GA on, after consent.
PUBLIC_GA_ID=

